<?xml version="1.0" encoding="utf-8"?>
<odoo>
    
    <record id="view_social_post_tree" model="ir.ui.view">
        <field name="name">view_social_post_tree</field>
        <field name="model">social.post</field>
        <field name="arch" type="xml">
            <tree>
                <field name="subject" />
                <field name="publish_date" />
                <field name="publish_notes" />
            </tree>
        </field>
    </record>
    
    <record id="view_social_post_form" model="ir.ui.view">
        <field name="name">view_social_post_form</field>
        <field name="model">social.post</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button type="object" name="button_was_published_today" string="Published Today"
                        invisible="publish_date!=False" class="oe_highlight" />
                </header>
                <sheet>
                    <group>
                        <field name="company_id" groups="base.group_multi_company" />
                        <field name="subject" />
                        <field name="publish_date" />
                    </group>
                    <notebook>
                        <page string="Composition">
                            <group>
                                <field name="post_body" />
                            </group>
                        </page>
                        <page string="Multimedia">
                            <group>
                                <field name="photos_ids" mode="kanban" />
                            </group>
                        </page>
                        <page string="Publish">
                            <group>
                                <field name="publish_notes" />
                            </group>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>
    
    <record id="action_social_post" model="ir.actions.act_window">
        <field name="name">Social Posts</field>
        <field name="res_model">social.post</field>
        <field name="view_mode">tree,form</field>
    </record>
    
    <menuitem id="menu_social_post"
        action="action_social_post"
        name="Social Posts"
        sequence="30"
        groups="base.group_user"
        />

</odoo>
